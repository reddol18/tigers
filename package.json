{
  "name": "blog-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NODE_ENV=local && next dev",
    "build": "cross-env NODE_ENV=production next build",
    "postbuild": "next-sitemap",
    "start": "cross-env NODE_ENV=production next start",    
    "ssg-build": "set NODE_ENV=production && npm run backup-pages && next build && npm run merge-pages && next-sitemap",
    "backup-pages": "rm -rf out_backup2 && mv out_backup out_backup2 && cp -r out/post out_backup",
    "merge-pages": "cp -r out_backup/* out/post",
    "deploy": "npm run copy-sitemap && touch out/.nojekyll && cp CNAME out/CNAME && gh-pages -d out -b gh-pages --dotfiles",
    "copy-sitemap": "cp public/sitemap*.xml public/robots.txt out/"
  },
  "homepage": "https://tigers.reddol18.pe.kr",
  "dependencies": {
    "classnames": "^2.5.1",
    "daisyui": "^5.0.35",
    "date-fns": "^3.6.0",
    "gray-matter": "^4.0.3",
    "he": "^1.2.0",
    "html-entities": "^2.6.0",
    "next": "15.0.2",
    "next-sitemap": "^4.2.3",
    "pg": "^8.16.0",
    "react": "19.0.0-rc-02c0e824-20241028",
    "react-dom": "19.0.0-rc-02c0e824-20241028",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rehype-raw": "^7.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "typeorm": "^0.3.24",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^20.14.8",
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2"
  }
}